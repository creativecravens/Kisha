door:{html:f=>'<div class="dr">'+roomC('#F1E4D0','#B07F52','🖼️ 💡<br>🛋️ 🪴','','inside')+'<div class="dr-wall"><span class="dr-num">'+esc(HOME.num)+'</span><div class="dr-door"><span class="knob"></span></div></div><div class="cap-top"><span class="tok dr-t"></span></div></div>',
  init:(s,f)=>{
    const dr=$('.dr',s), t=$('.dr-t',s), closed=f.hook||'Wait for it… 🚪';
    const go=o=>{ dr.classList.toggle('open',o); t.textContent=o?'Didn’t expect THAT 😮':closed; };
    go(false); later(1400,()=>go(true));
    dr.addEventListener('click',()=>go(!dr.classList.contains('open')));
  }},

details:{html:f=>'<div class="scene dtl">'+DT.map(d=>'<button class="dt" data-k="'+d[0]+'"><span class="off-e">'+d[1]+'</span><span class="on-e">'+d[2]+'</span><small>'+d[3]+'</small></button>').join('')+'</div><div class="cap-top">'+tok(f.hook||f.title)+'</div>',
  init:s=>{
    const tiles=$$('.dt',s); let auto=true, n=0;
    tiles.forEach(tl=>tl.addEventListener('click',()=>{ auto=false; tl.classList.toggle('on'); }));
    every(700,()=>{ if(!auto) return; if(n<tiles.length) tiles[n].classList.add('on'); n++; if(n>tiles.length+3){ tiles.forEach(x=>x.classList.remove('on')); n=0; } });
  }},

driveup:{html:f=>{
    const lines=(f.hook||f.title).split('\n').filter(Boolean), first=lines.length>1?lines[0]:'', last=lines[lines.length-1];
    return '<div class="dv'+(f.photo?' has-photo':'')+'">'+(f.photo?'<div class="scene photo"'+bgStyle(f.photo)+'></div>':ext({wall:'#F7F1E6',roof:'#36454F',door:'#B5523A'}))+'<div class="dv-frame"></div><div class="dv-mirror"></div><div class="dv-dash"></div>'+(first?'<div class="cap-top dv-start">'+tok(first)+'</div>':'')+'<div class="cap-top dv-text">'+tok(last)+'</div></div>';
  },
  init:s=>{
    const dv=$('.dv',s); let tm=null;
    const play=()=>{ dv.classList.remove('go','done'); void dv.offsetWidth; dv.classList.add('go'); if(tm) clearTimeout(tm); tm=later(3400,()=>dv.classList.add('done')); };
    play(); dv.addEventListener('click',play);
  }},

thisorthat:{html:f=>'<div class="tt"><div class="cap-top">'+tok(f.hook||'Which one are you picking? 👇')+'</div>'+
    '<button class="tt-opt" data-v="0" aria-label="Vote for A">'+kitchen({wall:'#F4F4F1',floor:'#D4CCC0',cab:'#C9C4BA',items:'🥑 ☕ 🍋'})+'<span class="tt-lab">A</span><span class="tt-pct"></span><span class="tt-fill"></span></button>'+
    '<div class="tt-vs"><span>OR</span></div>'+
    '<button class="tt-opt" data-v="1" aria-label="Vote for B">'+kitchen({wall:'#E9D8BF',floor:'#8A6648',cab:'#2F5D4A',items:'🍞 🫖 🧺'})+'<span class="tt-lab">B</span><span class="tt-pct"></span><span class="tt-fill"></span></button></div>',
  init:s=>{
    const opts=$$('.tt-opt',s), tt=$('.tt',s); const base=[570,430]; let voted=false;
    opts.forEach(o=>o.addEventListener('click',()=>{
      if(voted){ tt.classList.remove('voted'); opts.forEach(x=>x.classList.remove('pick')); voted=false; return; }
      voted=true; const v=+o.dataset.v; const votes=[base[0]+(v===0?1:0), base[1]+(v===1?1:0)]; const tot=votes[0]+votes[1];
      o.classList.add('pick'); tt.classList.add('voted');
      opts.forEach((x,j)=>{ const p=Math.round(votes[j]/tot*100); $('.tt-pct',x).textContent=p+'%'; $('.tt-fill',x).style.width=p+'%'; });
    }));
  }},

simple:{html:f=>{
    if(f.cat==='carousel'){
      const sl=f.slides.length?f.slides:[f.hook||f.title,f.short].filter(Boolean);
      return sliderHTML(sl.map((t,i)=>(i===0&&f.photo?'<div class="scene photo"'+bgStyle(f.photo)+'></div>':SIMPLE_SCENES[i%SIMPLE_SCENES.length]())+band(t,'')));
    }
    return '<div class="pov"><div class="pov-stage">'+(f.photo?'<div class="scene photo"'+bgStyle(f.photo)+'></div>':SIMPLE_SCENES.map(fn=>fn()).join(''))+'</div><div class="cap-top cap-low">'+tok(f.hook||f.title)+'</div></div>';
  },
  init:(s,f)=>{
    if(f.cat==='carousel'){ sliderInit(s,2600); return; }
    const sc=$$('.pov-stage .scene',s); let i=0; sc[0].classList.add('on');
    if(sc.length>1) every(1600,()=>{ sc[i].classList.remove('on'); i=(i+1)%sc.length; sc[i].classList.add('on'); });
  }}
};

/* ---------- memes ---------- */
const EMO=/^((?:\p{Extended_Pictographic}|\p{Regional_Indicator})(?:\uFE0F|\u200D|\p{Extended_Pictographic}|[\u{1F3FB}-\u{1F3FF}])*)\s*(.*)$/u;
function memeHTML(f,v){
  const a=esc(v.a||''), b=esc(v.b||''), handle=esc(HANDLE);
  const pane=(cls,emo,lab,text,img)=>'<div class="mp '+cls+(img?' has-img':'')+'"'+(img?bgStyle(img):'')+'>'+(img?'':'<span class="mp-emo">'+esc(emo)+'</span>')+'<span class="mp-lab">'+esc(lab)+'</span><b>'+text+'</b></div>';
  if(f.layout==='two') return '<div class="mm two">'+pane('p1',f.emojis[0],f.labels[0],a,v.ia)+pane('p2',f.emojis[1],f.labels[1],b,v.ib)+'<span class="mm-handle">'+handle+'</span></div>';
  if(f.layout==='dict') return '<div class="mm dict"><span class="dict-top">📖 The realtor dictionary</span><b class="dict-w">'+a+'</b><i class="dict-pos">(adj.) seen in listings</i><div class="dict-rule"></div><p class="dict-m"><span>What it really means</span>'+b+'</p><span class="mm-handle">'+handle+'</span></div>';
  if(f.layout==='stack') return '<div class="mm stack">'+(f.sceneImg?'<div class="scene photo"'+bgStyle(f.sceneImg)+'></div>':sceneFor(f.scene))+'<b class="mt top">'+a+'</b><b class="mt bot">'+b+'</b></div>';
  const pimg=v.ia||v.ib;
  if(f.layout==='post') return '<div class="mm post"><div class="post-card'+(pimg?' has-img':'')+'"><div class="post-h"><span class="av">'+(LOGOS.mark?'<img alt="" src="'+LOGOS.mark+'">':'🏡')+'</span><div><b>'+esc(BIZ)+'</b><small>'+handle+'</small></div></div><p class="post-a">'+a+'</p><p class="post-b">'+b+'</p>'+(pimg?'<img class="post-img" alt="" src="'+esc(pimg)+'">':'')+'<div class="post-f"><span>💬 248</span><span>🔁 61</span><span>♡ 1.2K</span></div></div></div>';
  const items=(v.b||'').split(',').map(x=>x.trim()).filter(Boolean).slice(0,6);
  return '<div class="mm starter"><b class="st-title">'+a+'</b><div class="st-grid">'+items.map(it=>{ const m=it.match(EMO); return '<div class="st-it"><span>'+(m?m[1]:'🏠')+'</span><small>'+esc(m?m[2]:it)+'</small></div>'; }).join('')+'</div></div>';
}
function makerLabels(f){
  if(f.layout==='two') return f.labels;
  if(f.layout==='dict') return ['Listing word','What it really means'];
  if(f.layout==='starter') return ['Title','Items (separate with commas)'];
  if(f.layout==='post') return ['First line','Second line'];
  return ['Top text','Bottom text'];
}
DEMOS.meme={
  html:f=>'<div class="meme-holder">'+memeHTML(f,memeVal(f))+'</div>',
  init:(s,f)=>{ $('.meme-holder',s).addEventListener('click',()=>nextExample(f)); }
};

/* ---------- state ---------- */
const state={filter:'all',sel:null,tab:'how',made:new Set(),hideMade:false,memeVals:{},exIdx:{}};
const KEY='faceless-kit-made-v1';
try{ const raw=localStorage.getItem(KEY); if(raw) JSON.parse(raw).forEach(id=>{ if(byId(id)) state.made.add(id); }); }catch(e){}
function saveMade(){ try{ localStorage.setItem(KEY,JSON.stringify(Array.from(state.made))); }catch(e){} }
function memeVal(f){ return state.memeVals[f.id] || f.examples[state.exIdx[f.id]||0]; }

const studio=$('#studio'), screen=$('#screen'), mq=window.matchMedia('(max-width: 900px)');
const catVars = c => '--c:var(--c-'+c+');--t:var(--tint-'+c+');--on:var(--on-'+c+')';
const activeGroups=()=>GROUP_KEYS.filter(k=>ITEMS.some(f=>f.cat===k));

/* ---------- page text ---------- */
function renderPageText(){
  const title=set(S,'pageTitle','Faceless post kit');
  document.title=BIZ+' | '+title;
  const lf=txt(S.logoFile), ld=txt(S.logoFileDark);
  const setLogo=(img,src,fallback)=>{ img.onerror=()=>{ img.onerror=null; if(fallback) img.src=fallback; }; img.src=src||fallback||''; };
  setLogo($('#logoLight'), lf, LOGOS.color);
  setLogo($('#logoDark'), ld||lf, LOGOS.white);
  $('#logoLight').alt=$('#logoDark').alt=BIZ;
  if(LOGOS.mark) $('#favicon').href=LOGOS.mark;
  $('#bizName').textContent=title;
  $('#headline').textContent=set(S,'headline','Easy posts that sell homes.');
  $('#intro').textContent=txt(S.intro).replace(/\{count\}/g,ITEMS.length);
  $('#randBtn').textContent=set(S,'randomButton','🎲 Pick one for me');
  $('#rulesTitle').textContent=txt(S.rulesTitle);
  $('#rulesIntro').textContent=txt(S.rulesIntro);
  $('#ruleList').innerHTML=arr(RULE_LIST).filter(Array.isArray).map(r=>'<div class="rule"><span class="e">'+esc(txt(r[0]))+'</span><div><b>'+esc(txt(r[1]))+'</b><p>'+esc(txt(r[2]))+'</p></div></div>').join('');
  const tools=txt(S.freeTools); const tl=$('#toolsLine'); tl.hidden=!tools; tl.innerHTML='🧰 <b>Free tools:</b> '+esc(tools);
  $('#footerText').textContent=txt(S.footer);
  $('#chips').innerHTML='<button class="chip" data-f="all" aria-pressed="true">All ideas</button>'+activeGroups().map(k=>'<button class="chip" data-f="'+k+'" aria-pressed="false">'+esc(CATS[k].icon+' '+CATS[k].name)+'</button>').join('');
}
function renderYard(){
  $('#yard').innerHTML=activeGroups().map(k=>{ const c=CATS[k]; const n=ITEMS.filter(f=>f.cat===k).length;
    return '<button class="sign" data-f="'+k+'" style="'+catVars(k)+';--h:'+c.h+'"><span class="arm"><span class="sign-panel"><span class="sign-emo">'+esc(c.icon)+'</span><b>'+esc(c.name)+'</b><small>'+n+' idea'+(n===1?'':'s')+'</small></span></span></button>'; }).join('');
}
function deco(cat){
  if(cat==='carousel') return '<span class="deco dots"><i></i><i></i><i></i></span>';
  if(cat==='video') return '<span class="deco play">▶</span>';
  return '<span class="deco ha">HA!</span>';
}
function cardHTML(f){
  return '<article class="card'+(f.id===state.sel?' active':'')+(state.made.has(f.id)?' made':'')+'" role="button" tabindex="0" data-id="'+esc(f.id)+'" style="'+catVars(f.cat)+'" aria-label="'+esc(f.title)+'">'+
    '<div class="thumb'+(f.thumb?' has-photo"'+bgStyle(f.thumb):'"')+'><span class="made-badge">✓ Made</span><span class="t-emo">'+esc(f.icon)+'</span>'+deco(f.cat)+'</div>'+
    '<div class="card-body"><h3>'+esc(f.title)+'</h3><p>'+esc(f.short)+'</p><div class="chipset">'+(f.time?'<span>⏱ '+esc(f.time)+'</span>':'')+(f.length?'<span>'+esc(f.length)+'</span>':'')+'</div></div></article>';
}
function renderList(){
  let html='';
  activeGroups().forEach(k=>{
    if(state.filter!=='all' && state.filter!==k) return;
    const c=CATS[k], all=ITEMS.filter(f=>f.cat===k), items=all.filter(f=>!state.hideMade || !state.made.has(f.id));
    html+='<section class="group" id="g-'+k+'" style="'+catVars(k)+'"><div class="group-head"><span class="group-icon">'+esc(c.icon)+'</span><div><h2>'+esc(c.name)+'</h2><p>'+esc(c.sub)+'</p></div><span class="group-count">'+all.filter(f=>state.made.has(f.id)).length+' of '+all.length+' made</span></div>';
    html+= items.length ? '<div class="cards">'+items.map(cardHTML).join('')+'</div>' : '<p class="empty">You’ve made every idea in this group. Turn off “Hide ones I made” to see them again.</p>';
    html+='</section>';
  });
  $('#list').innerHTML=html;
}
function demoActive(){ return !mq.matches || studio.classList.contains('open'); }
function renderDemo(f){
  clearDemo();
  if(!demoActive()){ screen.innerHTML=''; return; }
  const d = f.cat==='meme' ? DEMOS.meme : DEMOS[f.demo];
  const chrome = f.cat==='video' && (CHROME_ON.indexOf(f.demo)>=0 || f.demo==='simple');
  screen.innerHTML = d.html(f) + (chrome?CHROME:'');
  if(d.init) d.init(screen,f);
}
function renderStudio(){
  const f=byId(state.sel);
  studio.setAttribute('style',catVars(f.cat));
  $('#sCat').textContent=CATS[f.cat].icon+' '+CATS[f.cat].short;
  $('#sPos').textContent='Idea '+f.n+' of '+ITEMS.length;
  $('#sTitle').textContent=f.title;
  $('#sShort').textContent=f.short;
  $('#sMeta').innerHTML=(f.time?'<span>⏱ '+esc(f.time)+'</span>':'')+(f.length?'<span>📏 '+esc(f.length)+'</span>':'')+'<span>'+(/easy/i.test(f.level)?'🟢':'🟡')+' '+esc(f.level)+'</span>';
  $('#phoneHint').textContent=(f.demo==='beforeafter'&&isReel(f))?'Tap the phone to play the reel again.':(HINTS[f.cat==='meme'?'meme':f.demo]||'');
  const tip=$('#sTip'); tip.hidden=!f.tip; tip.innerHTML='💡 <b>Tip:</b> '+esc(f.tip);
  renderTabs(f); renderPanel(f); updateMadeBtn(); renderDemo(f);
}
function tabList(f){ return f.cat==='meme' ? [['maker','Meme maker'],['how','How to make it'],['copy','Caption']] : [['how','How to make it'],['copy','Copy and paste']]; }
function renderTabs(f){ $('#tabs').innerHTML=tabList(f).map(t=>'<button role="tab" data-tab="'+t[0]+'" aria-selected="'+(state.tab===t[0])+'">'+t[1]+'</button>').join(''); }
function copyBlock(label,text){ return '<div class="copyblock"><div class="lab"><span>'+label+'</span><button class="copy-btn" data-copy="'+esc(text)+'">Copy</button></div><p>'+esc(text)+'</p></div>'; }
function renderPanel(f){
  const p=$('#tabpanel');
  if(state.tab==='how'){
    p.innerHTML=(f.exImg?'<figure class="example-fig"><span class="ex-badge">Example only</span><img alt="Example" src="'+esc(f.exImg)+'">'+(f.exNote?'<figcaption>'+esc(f.exNote)+'</figcaption>':'')+'</figure>':'')+(f.steps.length?'<ol class="steps">'+f.steps.map(s=>'<li><span>'+esc(s)+'</span></li>').join('')+'</ol>':'<p class="note">No steps yet. Add them in the EDIT HERE section.</p>')+(CATS[f.cat].tools?'<p class="tools">🧰 <b>Tools:</b> '+esc(CATS[f.cat].tools)+'</p>':'');
  } else if(state.tab==='copy'){
    const tags=((f.tags||CATS[f.cat].tags)+' '+txt(S.cityHashtag)).trim();
    p.innerHTML=(f.hook?copyBlock('Text on screen',f.hook):'')+(f.caption?copyBlock('Caption',f.caption):'')+(tags?copyBlock('Hashtags',tags):'');
  } else {
    const v=memeVal(f), L=makerLabels(f);
    p.innerHTML='<div class="maker"><label>'+esc(L[0])+'<textarea data-k="a" rows="2">'+esc(v.a)+'</textarea></label><label>'+esc(L[1])+'<textarea data-k="b" rows="'+(f.layout==='starter'?4:(f.layout==='post'?3:2))+'">'+esc(v.b)+'</textarea></label>'+
      '<div class="maker-row"><button class="btn" data-act="ex">🎲 Another example</button><button class="btn" data-act="copymeme">Copy text</button></div>'+
      '<p class="note">Type your own words and the phone updates as you go. To keep it, take a screenshot of the phone or rebuild it in Canva with your own photo.</p></div>';
  }
}
function syncMaker(f){ if(state.tab!=='maker') return; const v=memeVal(f); $$('#tabpanel textarea').forEach(t=>{ t.value=v[t.dataset.k]||''; }); }
function updateMeme(f){ const h=$('.meme-holder',screen); if(h) h.innerHTML=memeHTML(f,memeVal(f)); }
function nextExample(f){ const i=((state.exIdx[f.id]||0)+1)%f.examples.length; state.exIdx[f.id]=i; state.memeVals[f.id]=Object.assign({},f.examples[i]); updateMeme(f); syncMaker(f); }
function updateMadeBtn(){ const m=state.made.has(state.sel), b=$('#madeBtn'); b.textContent=m?'✓ Made it':'Mark as made'; b.classList.toggle('done',m); }
function updateProgress(){
  const n=state.made.size, t=ITEMS.length;
  $('#progText').textContent=n+' of '+t+' made';
  $('#topMade').textContent=n?('You’ve made '+n+' so far'):'';
  $('#progFill').style.width=(t?n/t*100:0)+'%';
}

/* ---------- actions ---------- */
function select(id,open){
  state.sel=id; const f=byId(id);
  state.tab=f.cat==='meme'?'maker':'how';
  $$('.card').forEach(c=>c.classList.toggle('active',c.dataset.id===id));
  if(mq.matches && open) openSheet();
  renderStudio(); studio.scrollTop=0;
}
function openSheet(){ studio.classList.add('open'); document.body.classList.add('sheet-open'); }
function closeSheet(){ studio.classList.remove('open'); document.body.classList.remove('sheet-open'); clearDemo(); screen.innerHTML=''; }
function visibleItems(){ return ITEMS.filter(f=>(state.filter==='all'||f.cat===state.filter)&&(!state.hideMade||!state.made.has(f.id)||f.id===state.sel)); }
function stepBy(d){
  const v=visibleItems(); let i=v.findIndex(f=>f.id===state.sel); if(i<0) i=0;
  const n=v[(i+d+v.length)%v.length]; if(!n) return;
  select(n.id,false);
  if(!mq.matches){ const c=$('.card[data-id="'+n.id+'"]'); if(c) c.scrollIntoView({block:'nearest',behavior:'smooth'}); }
}
function setFilter(k){ state.filter=k; $$('.chip[data-f]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.f===k))); renderList(); }
let toastT=null;
function toast(msg){ const t=$('#toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(toastT); toastT=setTimeout(()=>t.classList.remove('show'),2200); }
async function copyText(text){
  let ok=false;
  try{ await navigator.clipboard.writeText(text); ok=true; }
  catch(e){ try{ const ta=document.createElement('textarea'); ta.value=text; ta.style.position='fixed'; ta.style.opacity='0'; document.body.appendChild(ta); ta.select(); ok=document.execCommand('copy'); ta.remove(); }catch(e2){} }
  toast(ok?'Copied 📋':'Copy didn’t work here. Press and hold the text to copy it.');
}

/* ---------- start ---------- */
if(!ITEMS.length){ showEditError('There are no ideas in the IDEAS or MEMES lists. Add at least one.'); return; }
renderPageText();
renderYard();
state.sel=ITEMS[0].id;
renderList(); renderStudio(); updateProgress();

/* ---------- events ---------- */
$('#list').addEventListener('click',e=>{ const c=e.target.closest('.card'); if(c) select(c.dataset.id,true); });
$('#list').addEventListener('keydown',e=>{ if((e.key==='Enter'||e.key===' ') && e.target.classList.contains('card')){ e.preventDefault(); select(e.target.dataset.id,true); } });
$('#chips').addEventListener('click',e=>{ const b=e.target.closest('.chip[data-f]'); if(b) setFilter(b.dataset.f); });
$('#yard').addEventListener('click',e=>{ const b=e.target.closest('.sign'); if(!b) return; setFilter(b.dataset.f); const first=ITEMS.find(f=>f.cat===b.dataset.f); if(first && !mq.matches) select(first.id,false); const g=$('#g-'+b.dataset.f); if(g) g.scrollIntoView({behavior:'smooth',block:'start'}); });
$('#hideMade').addEventListener('change',e=>{ state.hideMade=e.target.checked; renderList(); });
$('#prevBtn').addEventListener('click',()=>stepBy(-1));
$('#nextBtn').addEventListener('click',()=>stepBy(1));
$('#closeSheet').addEventListener('click',closeSheet);
$('#madeBtn').addEventListener('click',()=>{
  const id=state.sel;
  if(state.made.has(id)) state.made.delete(id); else { state.made.add(id); toast('Marked as made ✓'); }
  saveMade(); updateMadeBtn(); updateProgress(); renderList();
});
let resetArmed=false;
$('#resetBtn').addEventListener('click',e=>{
  if(!resetArmed){ resetArmed=true; e.target.textContent='Click again to reset'; setTimeout(()=>{ resetArmed=false; e.target.textContent='Reset my progress'; },3000); return; }
  resetArmed=false; e.target.textContent='Reset my progress'; state.made.clear(); saveMade(); updateMadeBtn(); updateProgress(); renderList(); toast('Progress reset');
});
$('#tabs').addEventListener('click',e=>{ const b=e.target.closest('[data-tab]'); if(!b) return; state.tab=b.dataset.tab; const f=byId(state.sel); renderTabs(f); renderPanel(f); });
$('#tabpanel').addEventListener('click',e=>{
  const c=e.target.closest('[data-copy]'); if(c){ copyText(c.dataset.copy); return; }
  const a=e.target.closest('[data-act]'); if(!a) return; const f=byId(state.sel);
  if(a.dataset.act==='ex') nextExample(f);
  if(a.dataset.act==='copymeme'){ const v=memeVal(f); copyText(v.a+'\n'+v.b); }
});
$('#tabpanel').addEventListener('input',e=>{
  const t=e.target; if(t.tagName!=='TEXTAREA') return; const f=byId(state.sel);
  const cur=Object.assign({},memeVal(f)); cur[t.dataset.k]=t.value; state.memeVals[f.id]=cur; updateMeme(f);
});
$('#randBtn').addEventListener('click',()=>{
  const pool=ITEMS.filter(f=>!state.made.has(f.id)&&f.id!==state.sel); const list=pool.length?pool:ITEMS;
  const f=list[Math.floor(Math.random()*list.length)];
  if(state.filter!=='all' && state.filter!==f.cat) setFilter('all');
  select(f.id,true); toast('🎲 Try this one: '+f.title);
  if(!mq.matches){ const c=$('.card[data-id="'+f.id+'"]'); if(c){ c.scrollIntoView({behavior:'smooth',block:'center'}); c.classList.add('flash'); setTimeout(()=>c.classList.remove('flash'),1500); } }
});
document.addEventListener('keydown',e=>{
  const tag=(e.target.tagName||'').toLowerCase(); if(tag==='textarea'||tag==='input') return;
  if(e.key==='ArrowRight') stepBy(1);
  else if(e.key==='ArrowLeft') stepBy(-1);
  else if(e.key==='Escape' && studio.classList.contains('open')) closeSheet();
});
const onMQ=()=>{ if(!mq.matches){ studio.classList.remove('open'); document.body.classList.remove('sheet-open'); renderDemo(byId(state.sel)); } else { closeSheet(); } };
if(mq.addEventListener) mq.addEventListener('change',onMQ); else if(mq.addListener) mq.addListener(onMQ);
})();
</script>
