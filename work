function sliderHTML(slides){
  return '<div class="slider"><div class="track">'+slides.map(s=>'<div class="slide">'+s+'</div>').join('')+'</div>'+
  '<button class="nav nav-l" aria-label="Previous slide"></button><button class="nav nav-r" aria-label="Next slide"></button>'+
  '<div class="dots">'+slides.map((_,i)=>'<span class="dot'+(i?'':' on')+'"></span>').join('')+'</div><div class="counter">1/'+slides.length+'</div></div>';
}
function sliderInit(s,ms){
  const sl=$('.slider',s); if(!sl) return;
  const track=$('.track',sl), dots=$$('.dot',sl), n=dots.length, counter=$('.counter',sl);
  let i=0, auto=true, swiped=false, x0=null;
  const go=k=>{ i=(k+n)%n; track.style.transform='translateX('+(-i*100)+'%)'; dots.forEach((d,j)=>d.classList.toggle('on',j===i)); counter.textContent=(i+1)+'/'+n; };
  $('.nav-l',sl).addEventListener('click',()=>{ if(swiped){swiped=false;return;} auto=false; go(i-1); });
  $('.nav-r',sl).addEventListener('click',()=>{ if(swiped){swiped=false;return;} auto=false; go(i+1); });
  sl.addEventListener('pointerdown',e=>{x0=e.clientX});
  sl.addEventListener('pointerup',e=>{ if(x0===null) return; const dx=e.clientX-x0; x0=null; if(Math.abs(dx)>30){ swiped=true; setTimeout(()=>{swiped=false},80); auto=false; go(i+(dx<0?1:-1)); } });
  every(ms||2600,()=>{ if(auto) go(i+1); });
}
function confetti(s){
  const E=['🎉','✨','🔑','🏡'];
  for(let k=0;k<14;k++){
    const sp=document.createElement('span'); sp.className='confetti'; sp.textContent=E[k%E.length];
    sp.style.left=(Math.random()*88)+'%'; sp.style.top='-24px'; sp.style.animationDelay=(Math.random()*.4)+'s';
    s.appendChild(sp); later(2100,()=>sp.remove());
  }
}
function countUp(s){
  const els=$$('[data-to]',s); const t0=performance.now(); let alive=true; cleanups.push(()=>{alive=false});
  const step=t=>{ if(!alive) return; const p=Math.min(1,(t-t0)/1100), e=1-Math.pow(1-p,3);
    els.forEach(el=>{ el.textContent=el.dataset.pre+Math.round(el.dataset.to*e).toLocaleString('en-US')+el.dataset.post; });
    if(p<1) requestAnimationFrame(step); };
  requestAnimationFrame(step);
}

