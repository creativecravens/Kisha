.empty{color:var(--muted);font-weight:600;margin:0}

/* ---------- studio ---------- */
.studio{position:sticky;top:calc(env(safe-area-inset-top,0px) + 84px);background:var(--surface);border:2px solid var(--line);border-radius:16px;padding:20px;max-height:calc(100vh - 104px);max-height:calc(100dvh - 104px);overflow:auto;box-shadow:6px 6px 0 var(--drop);overscroll-behavior:contain}
.phone{width:270px;max-width:100%;margin:0 auto;padding:9px;border-radius:40px;background:#000;box-shadow:0 0 0 2px var(--line)}
.screen-wrap{position:relative;aspect-ratio:9/16;border-radius:31px;overflow:hidden;background:#0d1110;isolation:isolate}
.screen-wrap::after{content:"";position:absolute;top:8px;left:50%;width:72px;height:18px;margin-left:-36px;border-radius:12px;background:#000;z-index:30;pointer-events:none}
.screen{position:absolute;inset:0;color:#fff;font-family:var(--font-body);-webkit-user-select:none;user-select:none;overflow:hidden}
.phone-hint{text-align:center;font-size:14px;color:var(--muted);margin:10px 0 0;font-weight:600}
.studio-top{display:flex;align-items:center;gap:10px;margin:18px 0 4px}
.cat-pill{font-weight:800;font-size:13px;background:var(--c);color:var(--on);padding:4px 11px;border-radius:20px;border:2px solid var(--line)}
.pos{font-size:13px;color:var(--muted);font-weight:600}
.studio h2{font-weight:800;font-size:26px;line-height:1.1;margin:6px 0 8px}
.s-short{color:var(--muted);margin:0 0 12px;font-size:15.5px}
.meta{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
.meta span{font-size:13px;font-weight:700;background:var(--surface-2);padding:4px 10px;border-radius:20px}
.actions{display:grid;grid-template-columns:auto 1fr auto;gap:8px;margin-bottom:18px}
.actions .btn{padding:10px 8px;font-size:14px}
.tabs{display:flex;border:2px solid var(--line);border-radius:10px;overflow:hidden;margin-bottom:14px}
.tabs button{flex:1;border:0;background:var(--surface);color:var(--muted);font-weight:700;font-size:14px;padding:9px 6px;cursor:pointer}
.tabs button + button{border-left:2px solid var(--line)}
.tabs button[aria-selected="true"]{background:var(--btn);color:var(--btn-ink)}
.steps{list-style:none;counter-reset:s;margin:0;padding:0;display:grid;gap:12px}
.steps li{counter-increment:s;display:grid;grid-template-columns:30px 1fr;gap:12px;align-items:start;font-size:15px;line-height:1.45}
.steps li::before{content:counter(s);width:30px;height:30px;border-radius:50%;background:var(--c);color:var(--on);border:2px solid var(--line);font-weight:800;font-size:14px;display:grid;place-items:center}
.tools{font-size:14px;color:var(--muted);margin:16px 0 0}
.tools b{color:var(--ink)}
.copyblock{border:2px solid var(--hair);border-radius:12px;padding:12px 14px;margin-bottom:10px;background:var(--bg)}
.copyblock .lab{font-weight:800;font-size:13px;color:var(--muted);display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:6px}
.copyblock p{margin:0;font-size:15px;white-space:pre-wrap}
.copy-btn{font-weight:700;font-size:13px;border:2px solid var(--line);background:var(--surface);color:var(--ink);border-radius:8px;padding:4px 10px;cursor:pointer}
.tip-box{margin-top:16px;padding:12px 14px;border-radius:10px;background:var(--tint-meme);border:2px solid var(--line);font-size:14.5px;line-height:1.45}
.maker label{display:grid;gap:6px;font-weight:700;font-size:13px;color:var(--muted);margin-bottom:12px}
.maker textarea{font:500 15px var(--font-body);color:var(--ink);background:var(--bg);border:2px solid var(--line);border-radius:10px;padding:10px;resize:vertical;min-height:54px}
.maker-row{display:flex;gap:8px;flex-wrap:wrap}
.maker-row .btn{font-size:14px;padding:9px 14px}
.note{font-size:13.5px;color:var(--muted);margin:12px 0 0}
.sheet-x{display:none}
#chips{display:contents}
.edit-error{border:3px solid var(--c-video);background:var(--tint-video);color:var(--ink);border-radius:12px;padding:16px 18px;margin:16px 0;font-size:16px}
.edit-error p{margin:8px 0 0}
.linkbtn{background:none;border:0;padding:0;color:var(--muted);text-decoration:underline;cursor:pointer;font-size:14px;margin-left:8px}

@media (min-width:1240px){
  .layout{grid-template-columns:minmax(0,1fr) 650px}
  .studio-body{display:grid;grid-template-columns:270px minmax(0,1fr);gap:24px;align-items:start}
  .studio-top{margin-top:0}
}

/* ---------- rules ---------- */
.rules{padding:16px 0 30px}
.rules h2{font-weight:800;font-size:clamp(26px,3.4vw,38px);line-height:1;margin:0 0 8px}
.rules > p{color:var(--muted);margin:0 0 20px;max-width:60ch}
.rule-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));column-gap:36px;border-top:2px solid var(--line)}
.rule{display:grid;grid-template-columns:34px 1fr;gap:12px;padding:16px 0;border-bottom:1px solid var(--hair)}
.rule .e{font-size:24px;line-height:1.2}
.rule b{display:block;font-size:17px;font-weight:800;margin-bottom:2px}
.rule p{margin:0;color:var(--muted);font-size:15px}
.tools-line{margin:22px 0 0;padding:14px 16px;border-radius:12px;border:2px solid var(--line);background:var(--surface);font-size:15px}
footer{padding:10px 0 40px;color:var(--muted);font-size:14px}

/* toast */
.toast-wrap{position:fixed;left:0;right:0;bottom:0;padding:0 16px calc(env(safe-area-inset-bottom,0px) + 18px);display:flex;justify-content:center;pointer-events:none;z-index:90}
.toast{background:var(--btn);color:var(--btn-ink);padding:11px 18px;border-radius:12px;font-weight:700;font-size:15px;opacity:0;transform:translateY(12px);transition:opacity .25s, transform .25s;max-width:100%}
.toast.show{opacity:1;transform:none}

/* ---------- mobile ---------- */
@media (max-width:900px){
  .hero{grid-template-columns:1fr;gap:26px}
  .layout{grid-template-columns:1fr}
  .studio{position:fixed;inset:0;z-index:60;border-radius:0;border:0;box-shadow:none;max-height:none;padding:calc(env(safe-area-inset-top,0px) + 58px) 18px calc(env(safe-area-inset-bottom,0px) + 30px);transform:translateY(100%);visibility:hidden;transition:transform .35s cubic-bezier(.2,.8,.2,1), visibility 0s linear .35s}
  .studio.open{transform:none;visibility:visible;transition:transform .35s cubic-bezier(.2,.8,.2,1)}
  body.sheet-open{overflow:hidden}
  body.sheet-open .sheet-x{display:flex}
  .sheet-x{position:fixed;top:0;left:0;right:0;z-index:70;justify-content:flex-end;padding:calc(env(safe-area-inset-top,0px) + 10px) 14px 0;pointer-events:none}
  .sheet-x button{pointer-events:auto}
  .rule-list{grid-template-columns:1fr}
  .prog-track{width:70px}
}
@media (max-width:560px){
  .yard{gap:8px;padding:0}
  .sign-panel{left:12px;right:2%;padding:8px 8px 10px}
  .sign-panel b{font-size:16px}
  .sign-emo{font-size:22px}
  .cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .card h3{font-size:16.5px}
  .card p{display:none}
  .t-emo{font-size:38px}
}

/* =========== phone demo scenes =========== */
.scene{position:absolute;inset:0;overflow:hidden}
.scene > svg{position:absolute;inset:0;width:100%;height:100%;display:block}
.room{background:linear-gradient(to bottom,var(--wall) 0 62%,var(--floor) 62% 100%)}
.room::after{content:"";position:absolute;left:0;right:0;top:62%;height:4px;background:rgba(0,0,0,.12)}
.room-items{position:absolute;left:0;right:0;bottom:29%;text-align:center;font-size:46px;line-height:1.15;filter:drop-shadow(0 6px 6px rgba(0,0,0,.18));z-index:1}
.kcabs{position:absolute;top:15%;left:8%;right:8%;height:17%;display:flex;gap:4px}
.kcabs i{flex:1;background:#fff;border:2px solid #cfd6d9;border-radius:3px}
.kcounter{position:absolute;left:6%;right:6%;bottom:21%;height:20%;background:var(--cab,#4f5f68);border-radius:4px 4px 2px 2px;box-shadow:inset 0 9px 0 #f5f2ec;z-index:1}
.room.k .room-items{bottom:41%;font-size:32px;z-index:2}
.pendants{position:absolute;top:0;left:22%;right:22%;display:flex;justify-content:space-between;z-index:2}
.pendants i{width:2px;height:64px;background:#333;position:relative}
.pendants i::after{content:"";position:absolute;bottom:-12px;left:-11px;width:24px;height:13px;background:#1d2420;border-radius:12px 12px 2px 2px;box-shadow:0 12px 20px rgba(255,214,120,.8)}

.tok{background:#fff;color:#111;padding:3px 7px;border-radius:6px;-webkit-box-decoration-break:clone;box-decoration-break:clone}
.cap-top{position:absolute;top:44px;left:12px;right:12px;text-align:center;z-index:8;pointer-events:none;font-weight:700;font-size:14px;line-height:1.8}
.ex{position:absolute;top:32px;left:12px;font-size:10px;font-weight:700;background:rgba(0,0,0,.45);color:#fff;padding:3px 8px;border-radius:20px;z-index:8}

.ui-side{position:absolute;right:8px;bottom:96px;display:flex;flex-direction:column;gap:12px;z-index:9;pointer-events:none;text-align:center;font-size:20px;text-shadow:0 1px 4px rgba(0,0,0,.5)}
.ui-side small{display:block;font-size:9.5px;font-weight:700}

/* slider */
.slider{position:absolute;inset:0;touch-action:pan-y}
.track{display:flex;height:100%;transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.slide{flex:0 0 100%;height:100%;position:relative;overflow:hidden}
.nav{position:absolute;top:0;bottom:0;width:50%;background:none;border:0;cursor:pointer;z-index:6;padding:0}
.nav-l{left:0}.nav-r{right:0}
.dots{position:absolute;left:0;right:0;bottom:16px;display:flex;justify-content:center;gap:5px;z-index:7;pointer-events:none}
.dot{width:6px;height:6px;border-radius:4px;background:rgba(255,255,255,.55);box-shadow:0 0 0 1px rgba(0,0,0,.18);transition:width .3s, background .3s}
.dot.on{background:#fff;width:16px}
.counter{position:absolute;top:34px;right:10px;font-size:11px;font-weight:700;background:rgba(0,0,0,.5);padding:3px 8px;border-radius:20px;z-index:7;pointer-events:none}
.ov-band{position:absolute;left:12px;right:12px;bottom:40px;background:rgba(14,17,22,.82);border-radius:12px;padding:10px 12px;display:flex;flex-direction:column;gap:1px;z-index:3}
.ov-band b{font-weight:800;font-size:20px;line-height:1.05}
.ov-band small{font-size:12px;font-weight:600;opacity:.85}
.end{background:#4B7F47;display:grid;place-items:center;text-align:center}
.end-in{display:flex;flex-direction:column;gap:10px;align-items:center;padding:20px}
.end-logo{width:170px;max-width:80%;height:auto;display:block}
.end b{font-weight:800;font-size:23px;line-height:1}
.end span{background:#FFCE00;color:#000;padding:9px 16px;border-radius:10px;font-weight:800;font-size:15px}

/* just listed / sold */
.stamp{position:absolute;left:50%;top:36%;transform:translate(-50%,-50%) rotate(-7deg);background:#4B7F47;color:#fff;font-family:var(--font-head);font-size:23px;letter-spacing:.03em;padding:8px 14px 9px;border:3px solid #fff;border-radius:8px;box-shadow:0 10px 24px rgba(0,0,0,.35);white-space:nowrap;text-align:center;z-index:3;line-height:1.05}
.stamp small{display:block;font-family:var(--font-body);font-size:12px;letter-spacing:0;font-weight:700;margin-top:3px}
.stamp.pop{animation:stamp .5s cubic-bezier(.2,1.5,.4,1)}
@keyframes stamp{from{transform:translate(-50%,-50%) rotate(-7deg) scale(1.9);opacity:0}to{transform:translate(-50%,-50%) rotate(-7deg) scale(1);opacity:1}}
.chips-in{position:absolute;left:10px;right:10px;bottom:18px;display:flex;gap:6px;justify-content:center;z-index:6}
.chips-in button{font-weight:700;font-size:12px;border:0;border-radius:20px;padding:8px 11px;background:rgba(255,255,255,.9);color:#111111;cursor:pointer}
.chips-in button.on{background:#111111;color:#fff}

/* before / after */
.ba{position:absolute;inset:0}
.ba .before{filter:saturate(.35) brightness(.92)}
.ba .after{clip-path:inset(0 0 0 50%)}
.ba.anim .after{transition:clip-path .8s ease}
.ba.anim .ba-line{transition:left .8s ease}
.ba-line{position:absolute;top:0;bottom:0;left:50%;width:3px;margin-left:-1.5px;background:#fff;box-shadow:0 0 8px rgba(0,0,0,.4);pointer-events:none;z-index:3}
.ba-line span{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:34px;height:34px;border-radius:50%;background:#fff;color:#111111;display:grid;place-items:center;font-size:15px;font-weight:800}
.ba-lab{position:absolute;top:36px;font-weight:800;font-size:12px;background:rgba(0,0,0,.6);padding:5px 9px;border-radius:6px;z-index:4;pointer-events:none}
.ba-lab.l{left:10px}.ba-lab.r{right:10px;background:#4B7F47}
.ba-range{position:absolute;inset:0;width:100%;height:100%;opacity:0;margin:0;cursor:ew-resize;z-index:5;touch-action:pan-y}

/* text slides */
.txt{display:flex;flex-direction:column;justify-content:center;padding:44px 22px;gap:10px;text-align:left}
.txt.center{align-items:center;text-align:center}
.txt .kick{font-size:13px;font-weight:700;opacity:.85}
.txt .big{font-weight:800;font-size:26px;line-height:.98}
.txt .num{font-family:var(--font-head);font-size:60px;line-height:.9}
.txt .tip-t{font-weight:800;font-size:21px;line-height:1.02}
.txt .tip-s{font-size:14px;opacity:.9}
.txt .swipe{font-size:13px;font-weight:800;margin-top:8px}
.ta{background:#000;color:#fff}.tb{background:#FFCE00;color:#000}.tc{background:#4B7F47;color:#fff}

/* myth flip */
.flip{position:absolute;inset:0;perspective:900px;padding:46px 16px 66px;display:grid}
.flip-in{position:relative;transition:transform .7s cubic-bezier(.3,.7,.2,1);transform-style:preserve-3d;cursor:pointer}
.flip.on .flip-in{transform:rotateY(180deg)}
.face{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:16px;padding:22px 18px;display:flex;flex-direction:column;justify-content:center;gap:14px}
.face.front{background:#FDE3E0;color:#7a1d16}
.face.back{background:#DDF3E6;color:#14532d;transform:rotateY(180deg)}
.face .tag{align-self:flex-start;font-weight:800;font-size:13px;padding:6px 10px;border-radius:8px;background:#c9302c;color:#fff}
.face.back .tag{background:#1E8E5A}
.face b{font-weight:800;font-size:20px;line-height:1.05}
.face small{font-size:13px;font-weight:600;opacity:.85}
.mini-btn{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);font-weight:800;font-size:13px;background:#fff;color:#111111;border:0;border-radius:20px;padding:9px 16px;cursor:pointer;z-index:6;white-space:nowrap}

/* market */
.mkt{background:#1F361D;padding:58px 14px 14px;display:flex;flex-direction:column;gap:7px;cursor:pointer}
.mk-k{font-size:12px;font-weight:700;color:#FFCE00}
.mk-h{font-weight:800;font-size:21px;line-height:1;margin-bottom:2px}
.stat{background:rgba(255,255,255,.08);border-radius:10px;padding:7px 10px;display:grid;grid-template-columns:1fr auto;align-items:center;column-gap:8px}
.stat span{font-size:11.5px;opacity:.8;grid-column:1/-1}
.stat b{font-weight:800;font-size:18px;line-height:1.1}
.stat em{font-style:normal;font-size:11px;font-weight:700;padding:3px 7px;border-radius:20px;background:rgba(255,255,255,.16);white-space:nowrap}
.bars{display:flex;align-items:flex-end;gap:6px;height:62px;margin-top:4px}
.bars div{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;height:100%;justify-content:flex-end}
.bars i{display:block;width:100%;background:#FFCE00;border-radius:4px 4px 0 0;height:0;transition:height .9s cubic-bezier(.2,.8,.2,1)}
.bars small{font-size:9.5px;opacity:.75}

/* neighborhood map */
.map{background:#e9efe2}
.pin{position:absolute;width:40px;height:40px;margin:-46px 0 0 -20px;border-radius:50%;background:#fff;border:0;box-shadow:0 4px 10px rgba(0,0,0,.25);font-size:19px;display:grid;place-items:center;cursor:pointer;z-index:4;animation:drop .5s cubic-bezier(.3,1.5,.5,1) backwards;transition:transform .2s, background .2s}
.pin::after{content:"";position:absolute;bottom:-7px;left:50%;margin-left:-7px;border:7px solid transparent;border-top-color:#fff;border-bottom:0}
.pin.home{background:#4B7F47}.pin.home::after{border-top-color:#4B7F47}
.pin.on{transform:scale(1.2);background:#FFCE00}.pin.on::after{border-top-color:#FFCE00}
@keyframes drop{from{transform:translateY(-40px);opacity:0}to{transform:none;opacity:1}}
.map-title{position:absolute;top:36px;left:12px;right:12px;background:#111111;color:#fff;font-weight:800;font-size:14px;padding:9px 10px;border-radius:10px;text-align:center;z-index:5}
.map-card{position:absolute;left:12px;right:12px;bottom:16px;background:#fff;color:#111111;border-radius:12px;padding:10px 12px;box-shadow:0 8px 20px rgba(0,0,0,.2);z-index:5;display:flex;flex-direction:column}
.map-card b{font-size:15px}.map-card span{font-size:12.5px;color:#555555}
.swap{animation:swap .4s ease}
@keyframes swap{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

/* review */
.rv{cursor:pointer}
.rv .bgx{position:absolute;inset:0;filter:blur(3px) brightness(.7);transform:scale(1.1)}
.rv-card{position:absolute;left:14px;right:14px;top:50%;margin-top:-90px;background:#fffdf8;color:#111111;border-radius:16px;padding:18px 16px;box-shadow:0 14px 30px rgba(0,0,0,.35);z-index:3}
.stars{color:#e0a800;font-size:22px;letter-spacing:2px}
.stars i{font-style:normal;opacity:.18;transition:opacity .2s}
.stars i.on{opacity:1}
.q{font-weight:700;font-size:15.5px;line-height:1.3;margin:10px 0}
.who{font-size:12.5px;color:#555555;font-weight:600}

/* POV */
.pov{position:absolute;inset:0;cursor:pointer}
.pov-stage .scene{opacity:0;transition:opacity .35s;transform-origin:50% 60%}
.pov-stage .scene.on{opacity:1}
.segs{position:absolute;top:32px;left:10px;right:10px;display:flex;gap:4px;z-index:8}
.segs span{flex:1;height:3px;background:rgba(255,255,255,.4);border-radius:2px;overflow:hidden}
.segs i{display:block;height:100%;width:0;background:#fff}
.cap-low{top:52px}
.pov-room{position:absolute;bottom:16px;left:12px;font-size:12px;font-weight:700;background:rgba(0,0,0,.55);padding:5px 10px;border-radius:20px;z-index:8}
.paused{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,.6);padding:8px 14px;border-radius:20px;font-weight:800;font-size:13px;z-index:9}

/* guess */
.gs{position:absolute;inset:0}
.gs-bg .scene{opacity:0;transition:opacity .6s}
.gs-bg .scene.on{opacity:1}
.gs-opts{position:absolute;left:14px;right:52px;bottom:18px;display:grid;gap:7px;z-index:8}
.gs-opts button{font-weight:800;font-size:16px;padding:10px;border-radius:10px;border:0;background:rgba(255,255,255,.94);color:#111111;cursor:pointer;transition:background .2s, color .2s}
.gs-opts button.right{background:#1E8E5A;color:#fff}
.gs-opts button.wrong{background:#c9302c;color:#fff}
.gs-res{position:absolute;left:14px;right:14px;top:34%;text-align:center;z-index:9;font-weight:800;font-size:24px;line-height:1.05;text-shadow:0 2px 14px rgba(0,0,0,.7);animation:swap .4s}
.gs-res small{display:block;font-size:16px;font-weight:700;margin-top:6px}
.confetti{position:absolute;font-size:20px;animation:fall 1.5s ease-in forwards;z-index:10;pointer-events:none}
@keyframes fall{from{transform:translateY(0) rotate(0)}to{transform:translateY(460px) rotate(360deg);opacity:.2}}

/* feature */
.ft{position:absolute;inset:0;cursor:pointer}
.ft .scene{animation:kb 6s ease-in-out infinite alternate;transform-origin:50% 72%}
@keyframes kb{from{transform:scale(1)}to{transform:scale(1.2)}}
.heart{position:absolute;font-size:62px;pointer-events:none;z-index:10;animation:heart .9s forwards}
@keyframes heart{0%{transform:translate(-50%,-50%) scale(0)}30%{transform:translate(-50%,-50%) scale(1.2)}100%{transform:translate(-50%,-130%) scale(1);opacity:0}}

/* door */
.dr{position:absolute;inset:0;cursor:pointer}
.dr .inside{transform:scale(1.18);transition:transform 1.1s ease .2s}
.dr.open .inside{transform:scale(1)}
.dr-wall{position:absolute;inset:0;background:repeating-linear-gradient(to bottom,#E9E2D5 0 15px,#D6CCBA 15px 17px);perspective:700px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding-bottom:14%;transition:opacity .5s ease .45s;z-index:3}
.dr-wall::after{content:"";position:absolute;left:0;right:0;bottom:0;height:14%;background:#B9AB93}
.dr.open .dr-wall{opacity:0;pointer-events:none}
.dr-num{font-family:var(--font-head);color:#111111;font-size:17px;margin-bottom:10px;background:#fff;padding:2px 10px;border-radius:4px}
.dr-door{width:52%;height:56%;background:#2f5d4a;border:6px solid #fff;border-bottom:0;border-radius:4px 4px 0 0;transform-origin:left center;transition:transform .7s cubic-bezier(.5,0,.3,1);position:relative}
