  },
  init:s=>{
    const br=$('.br',s), chip=$('.br-chip',s), bar=$('.br-bar i',s), bef=$('.br-b',s), fl=$('.br-flash',s); const D=5400, CUT=2400; let t=0, was=false;
    const draw=()=>{ const af=t>=CUT; if(af&&!was){ fl.classList.remove('go'); void fl.offsetWidth; fl.classList.add('go'); }
      if(!af&&was){ br.classList.add('nt'); br.classList.remove('after'); void br.offsetWidth; br.classList.remove('nt'); }
      was=af; br.classList.toggle('after',af); chip.textContent=af?'After ✨':'Before';
      bar.style.width=(t/D*100)+'%'; bef.style.transform='scale('+(1+0.07*Math.min(t,CUT)/CUT)+')'; };
    every(50,()=>{ t+=50; if(t>=D) t=0; draw(); });
    br.addEventListener('click',()=>{ t=0; draw(); });
    draw();
  }
};
